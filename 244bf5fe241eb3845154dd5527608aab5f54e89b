        "id": 1000000
      },
      "writtenOn": "2026-10-05T15:15:54Z",
      "side": 1,
      "message": "Regex aren\u0027t supported at the moment.\nThis is mainly intended for preventing the validation of the pipeline files, which is working with this change.\n\nIt could be extended further in a follow-up change.",
      "parentUuid": "d35ffe55_e7d9ff3a",
      "range": {
        "startLine": 704,
        "startChar": 0,
        "endLine": 705,
        "endChar": 50
      },
      "revId": "244bf5fe241eb3845154dd5527608aab5f54e89b",
      "serverId": "d5d70762-12d0-45a1-890d-524b12d3f735"
    },
